# Copy this file to .env before running docker-compose.all-services.template.yml

# Database credentials (demo/dev only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Database names
CATALOG_DB_NAME=catalog_db
INVENTORY_DB_NAME=inventory_db
ORDER_DB_NAME=order_db
PAYMENT_DB_NAME=payment_db
SHIPPING_DB_NAME=shipping_db
NOTIFICATION_DB_NAME=notification_db

# Service ports
CATALOG_PORT=3001
INVENTORY_PORT=3002
ORDER_PORT=3003
PAYMENT_PORT=3004
SHIPPING_PORT=3005
NOTIFICATION_PORT=3006

# DB host ports (local machine)
CATALOG_DB_HOST_PORT=5431
INVENTORY_DB_HOST_PORT=5432
ORDER_DB_HOST_PORT=5433
PAYMENT_DB_HOST_PORT=5434
SHIPPING_DB_HOST_PORT=5435
NOTIFICATION_DB_HOST_PORT=5436

# Inter-service base URLs (inside Docker network)
CATALOG_BASE_URL=http://catalog-service:3001
INVENTORY_BASE_URL=http://inventory-service:3002
ORDER_BASE_URL=http://order-service:3003
PAYMENT_BASE_URL=http://payment-service:3004
SHIPPING_BASE_URL=http://shipping-service:3005
NOTIFICATION_BASE_URL=http://notification-service:3006

# Example app envs per service
CATALOG_DATABASE_URL=postgres://postgres:postgres@catalog-db:5432/catalog_db
INVENTORY_DATABASE_URL=postgres://postgres:postgres@inventory-db:5432/inventory_db
ORDER_DATABASE_URL=postgres://postgres:postgres@order-db:5432/order_db
PAYMENT_DATABASE_URL=postgres://postgres:postgres@payment-db:5432/payment_db
SHIPPING_DATABASE_URL=postgres://postgres:postgres@shipping-db:5432/shipping_db
NOTIFICATION_DATABASE_URL=postgres://postgres:postgres@notification-db:5432/notification_db

# Optional callback/event URLs
ORDER_CALLBACK_URL=http://order-service:3003/v1/orders
