FROM node:20-alpine

# Install curl and bash for health checks and script execution
RUN apk add --no-cache curl bash

# Set working directory
WORKDIR /app

# Copy only the seed entrypoint script
COPY seed-entrypoint.sh /app/seed-entrypoint.sh

# Make script executable
RUN chmod +x /app/seed-entrypoint.sh

# Entrypoint: run the seed script
ENTRYPOINT ["/bin/bash", "/app/seed-entrypoint.sh"]
