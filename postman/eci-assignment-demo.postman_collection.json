      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-correlation-id", "value": "{{$guid}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_type\": \"ORDER_CONFIRMED\",\n  \"order_id\": \"{{orderId}}\",\n  \"customer_id\": \"{{customerId}}\",\n  \"customer_email\": \"demo@example.com\",\n  \"customer_phone\": \"+911234567890\"\n}"
        },
        "url": {
          "raw": "{{baseUrlNotification}}/v1/notifications/events",
          "host": ["{{baseUrlNotification}}"],
          "path": ["v1", "notifications", "events"]
        }
      }
    },
    {
      "name": "17 - Metrics - Order",
      "request": {
        "method": "GET",
        "url": {
