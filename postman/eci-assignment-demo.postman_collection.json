              "pm.test('Shipment has shipment_id', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('shipment_id');",
              "  pm.collectionVariables.set('shipmentId', json.shipment_id);",
              "});"
            ]
          }
